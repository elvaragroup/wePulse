# Required for run_sim.py, probe_leakage.py, and label_truth.py.
# Every test runs against FakeLLMClient and needs no key.
#
# uv does not read .env automatically: after filling this in, run commands as
#   uv run --env-file .env python -m src.run_sim ...
# or export ANTHROPIC_API_KEY yourself before running.
ANTHROPIC_API_KEY=

# Required for src/diagnostics.py's Homogeneity/Redundancy metrics.
VOYAGE_API_KEY=
